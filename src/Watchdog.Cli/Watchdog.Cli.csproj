<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Watchdog.Cli</RootNamespace>
    <AssemblyName>watchdog</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchdog.Core\Watchdog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships next to the executable. PreserveNewest copies it again whenever it changes,
         so editing the file does not require a rebuild of the project. -->
    <None Update="watchdog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

</Project>
